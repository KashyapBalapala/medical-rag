{
  "name": "medical-rag",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "chroma:server": "chroma run --path ./chroma --host localhost --port 8000",
    "chroma:stop": "sh -c 'lsof -ti:8000 | xargs -r kill -9 2>/dev/null || true'",
    "chroma:status": "sh -c 'curl -sf --max-time 2 http://localhost:8000/api/v2/heartbeat >/dev/null && echo \"Chroma is running on http://localhost:8000\" || (ss -tlnp 2>/dev/null | grep -q \":8000\" && echo \"Port 8000 is in use but Chroma is not responding. Run: npm run chroma:stop\" || echo \"Chroma is not running. Run: npm run chroma:server\")'",
    "chroma:reset": "npm run chroma:stop && sh -c 'find ./chroma -mindepth 1 ! -name .gitkeep -delete 2>/dev/null; rm -rf ./chroma/*/ 2>/dev/null; true'",
    "reset:ingest": "tsx scripts/reset-ingest.ts",
    "ingest": "tsx scripts/ingest.ts",
    "test:retrieval": "tsx scripts/test.ts",
    "test:rag": "tsx scripts/rag-test.ts",
    "test:memory": "tsx scripts/memory-test.ts",
    "test:retrieval-query": "tsx scripts/retrieval-query-test.ts",
    "test:models": "tsx scripts/model-benchmark.ts",
    "index:bm25": "tsx scripts/rebuild-bm25.ts",
    "test:planner": "tsx scripts/test-planner.ts",
    "test:rrf": "tsx scripts/test-rrf.ts",
    "test:diversity": "tsx scripts/test-diversity-rerank.ts",
    "test:hybrid": "tsx scripts/test-hybrid-retrieval.ts"
  },
  "dependencies": {
    "@langchain/community": "^1.1.29",
    "@langchain/textsplitters": "^1.0.1",
    "@xenova/transformers": "^2.17.2",
    "chromadb": "^3.4.3",
    "framer-motion": "^12.40.0",
    "langchain": "^1.4.4",
    "next": "16.2.7",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "remark-gfm": "^4.0.1",
    "wink-bm25-text-search": "^3.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
